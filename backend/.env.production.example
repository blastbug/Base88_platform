# ==========================================================================
# BASE88 本番環境 .env テンプレート
#   backend/.env にコピーし、<...> の値を実際の値に置き換えてください。
#   値の一部は「発注者様よりご提供いただく事項」です（末尾の手順書参照）。
# ==========================================================================

APP_NAME=BASE88
APP_ENV=production
APP_KEY=                      # php artisan key:generate で自動生成
APP_DEBUG=false
APP_URL=https://api.base88.example.jp      # バックエンド(API/管理画面)のURL
APP_TIMEZONE=Asia/Tokyo

# 加盟会社向けフロント(Next.js)のURL（通知メールのリンク先に使用）
FRONTEND_URL=https://app.base88.example.jp

# --- データベース（PostgreSQL） ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=base88
DB_USERNAME=base88
DB_PASSWORD=<DB_PASSWORD>

# --- セッション / キャッシュ ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# --- キュー（メール送信は非同期。worker を常駐させること） ---
QUEUE_CONNECTION=database

# --- メール送信（Amazon SES の SMTP 例。Postmark/SendGrid も同形式で可） ---
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com   # SESのSMTPエンドポイント（東京）
MAIL_PORT=587
MAIL_USERNAME=<SES_SMTP_USERNAME>
MAIL_PASSWORD=<SES_SMTP_PASSWORD>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@base88.example.jp        # SESで検証済みの送信元
MAIL_FROM_NAME="${APP_NAME}"
# ※ SES API ドライバを使う場合は MAIL_MAILER=ses とし、AWS_ACCESS_KEY_ID /
#    AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION=ap-northeast-1 を設定。

# --- 添付ファイル保存 ---
FILESYSTEM_DISK=public        # サーバーローカル保存（storage:link 必須）
# S3 を使う場合は FILESYSTEM_DISK=s3 と AWS_* を設定。

# --- ログ ---
LOG_CHANNEL=stack
LOG_LEVEL=warning
